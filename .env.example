# Azure OpenAI (required)
OPENAI_API_KEY=
OPENAI_AZURE_ENDPOINT=https://<resource>.openai.azure.com
OPENAI_API_VERSION=2024-02-01
OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4.1
OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
OPENAI_AGENTS_DISABLE_TRACING=1

# Milvus Lite (local vector store; URI is relative to DATA_DIR)
MILVUS_DB_URI=./milvus.db
MILVUS_DB_COLLECTION_NAME=agent_inventory

# Retrieval Context
USE_IMAGE_CONTEXT=false
IMAGE_DETAIL="auto"

# Phoenix tracing (optional — evaluation / observability)
# Set to true to export traces and use the Phoenix-backed evaluation workflow.
# PHOENIX_TRACING_ENABLED=false
# PHOENIX_PROJECT_NAME=agent-demo
# PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_PROTOCOL=http/protobuf

# Agent API (optional — prefix AGENT_API_)
# AGENT_API_DATA_DIR=.agent-api-data
# AGENT_API_DATABASE_URL=
